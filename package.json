{
  "name": "videoclub-api-express-ts",
  "version": "0.1.0",
  "private": true,
  "description": "VideoClub REST API in TypeScript, Express 5 and layered architecture",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {"express": "^5.3.0", "zod": "^4.1.12"},
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.1",
    "supertest": "^7.1.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.0"
  }
}
